# Modelo do .env para desenvolvimento local e para a Vercel.
# Para a VPS da Hostinger use .env.production.example.

# ─── Banco (PostgreSQL) ───────────────────────────────────────────────────────
# Supabase: DATABASE_URL = pooler de transação (porta 6543, com ?pgbouncer=true); DIRECT_URL = sessão (5432), usada pelas migrations
# Postgres próprio (VPS): as duas iguais, ex.: postgresql://jm:SENHA@localhost:5432/jm_master
DATABASE_URL=
DIRECT_URL=

# ─── Arquivos (imagens do blog e documentos de clientes) ──────────────────────
# supabase (padrão) = Supabase Storage | local = disco do servidor, servido em /files/...
STORAGE_DRIVER=supabase
# Só no driver local: pasta onde os arquivos ficam (padrão ./storage)
STORAGE_DIR=
# Só no driver local: assina os links temporários dos documentos (se vazio, usa AUTH_SECRET)
STORAGE_SIGNING_SECRET=

# Só no driver supabase (e para os scripts de migração)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Segurança ────────────────────────────────────────────────────────────────
# Assinatura das sessões do painel. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Trocar este valor desloga todo mundo.
AUTH_SECRET=

# Autoriza o cron diário de faturamento (Vercel Cron ou crontab da VPS)
CRON_SECRET=

# Só para scripts/seed.mjs
SEED_DEFAULT_PASSWORD=
