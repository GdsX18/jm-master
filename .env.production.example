# Copie para .env.production na VPS (esse arquivo NÃO vai para o Git) e preencha.
# Usado pelo docker-compose.yml. Passo a passo em deploy/HOSTINGER.md.

# Domínio SEM "www" e sem https://. O site sobe em www.<DOMAIN> e o domínio puro redireciona para ele.
DOMAIN=jmmaster.com.br

# ─── PostgreSQL da VPS ────────────────────────────────────────────────────────
# O docker-compose monta DATABASE_URL/DIRECT_URL a partir destes três valores.
POSTGRES_DB=jm_master
POSTGRES_USER=jm
# Só letras e números (vai dentro de uma URL). Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=

# ─── Arquivos ─────────────────────────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_DIR=/app/storage

# ─── Segurança (pode reaproveitar os valores atuais da Vercel) ────────────────
# Mesmo AUTH_SECRET da Vercel = ninguém é deslogado na virada
AUTH_SECRET=
CRON_SECRET=

# ─── Só durante a migração (pode apagar depois da virada) ─────────────────────
# Usados por scripts/migrate/storage-from-supabase.mjs e rewrite-storage-urls.mjs
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
